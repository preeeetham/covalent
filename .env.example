# Copy to .env.local and fill in. Never commit real values.

# Supabase (local: `npx supabase status -o env`; hosted: Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Public URL of the app (used for metadata and share links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Payments: "mock" (default, test mode, no money moves) or "razorpay" (stub; see src/lib/payments)
PAYMENTS_PROVIDER=mock

# Password given to the 4 evaluator accounts by `npm run db:seed`
DEMO_PASSWORD=

# Optional AI garnish (why-you-two lines, round quips, demo persona chat).
# The app works fully without these. Get a free key at https://aistudio.google.com
# and set GEMINI_MODEL to a current free-tier "flash" model from
# https://ai.google.dev/gemini-api/docs/models (check the page; names change).
# Verified working Nov 2026: gemini-3.5-flash-lite (gemini-2.0/2.5 lite models are retired).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
